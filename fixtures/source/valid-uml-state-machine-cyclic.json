      "source": "idle",
      "target": "engaged",
      "label": "engage",
      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "engage"
        }
      }
    },
    {
      "id": "t-disengage",
      "type": "Transition",
      "source": "engaged",
      "target": "idle",
