      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "resume"
        }
      }
    },
    {
      "id": "t-review",
      "type": "Transition",
      "source": "running",
      "target": "reviewing",
      "label": "review",
      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "review"
        }
      }
    },
    {
      "id": "t-rework",
      "type": "Transition",
      "source": "reviewing",
      "target": "preparing",
      "label": "rework",
      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "rework"
        }
      }
    }
