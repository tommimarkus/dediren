  "plugins": {
    "generic-graph": {
      "semantic_profile": "uml",
      "views": [
        {
          "id": "state-machine-two-node-cycle-view",
          "label": "Minimal Two-State Cycle",
          "kind": "uml-state-machine",
          "nodes": ["idle", "engaged"],
          "relationships": ["t-engage", "t-disengage"],
          "layout_preferences": {
            "direction": "down",
            "density": "readable",
            "routing": {
              "style": "orthogonal",
              "endpoint_merging": "off"
            }
          },
          "groups": [
            {
              "id": "two-node-machine-frame",
              "label": "Session Lifecycle",
              "role": "semantic-boundary",
              "semantic_source_id": "session-machine",
              "members": ["two-node-region-frame"]
            },
            {
              "id": "two-node-region-frame",
              "label": "Session Region",
              "role": "semantic-boundary",
              "semantic_source_id": "session-region",
              "members": ["idle", "engaged"]
            }
          ]
        },
        {
          "id": "state-machine-multi-cycle-view",
          "label": "Multi-State Cycle",
          "kind": "uml-state-machine",
          "nodes": ["preparing", "running", "paused", "reviewing"],
          "relationships": ["t-start", "t-pause", "t-resume", "t-review", "t-rework"],
          "layout_preferences": {
            "direction": "down",
            "density": "readable",
            "routing": {
              "style": "orthogonal",
              "endpoint_merging": "off"
            }
          },
          "groups": [
            {
              "id": "multi-cycle-machine-frame",
              "label": "Session Lifecycle",
              "role": "semantic-boundary",
              "semantic_source_id": "session-machine",
              "members": ["multi-cycle-region-frame"]
            },
            {
              "id": "multi-cycle-region-frame",
              "label": "Session Region",
              "role": "semantic-boundary",
              "semantic_source_id": "session-region",
              "members": ["preparing", "running", "paused", "reviewing"]
            }
          ]
        }
      ]
    }
  }
}
