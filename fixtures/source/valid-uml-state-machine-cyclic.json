      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "disengage"
        }
      }
    },
    {
      "id": "t-start",
      "type": "Transition",
      "source": "preparing",
      "target": "running",
      "label": "start",
      "properties": {
        "uml": {
          "region": "session-region",
          "kind": "external",
          "trigger": "start"
        }
      }
    },
    {
      "id": "t-pause",
      "type": "Transition",
