      "type": "Region",
      "label": "Session Region",
      "properties": {
        "uml": {
          "state_machine": "session-machine"
        }
      }
    },
    {
      "id": "idle",
      "type": "State",
      "label": "Idle",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    },
    {
      "id": "engaged",
      "type": "State",
      "label": "Engaged",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    },
    {
      "id": "preparing",
      "type": "State",
      "label": "Preparing",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    },
    {
      "id": "running",
      "type": "State",
      "label": "Running",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    },
    {
      "id": "paused",
      "type": "State",
      "label": "Paused",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    },
    {
      "id": "reviewing",
      "type": "State",
      "label": "Reviewing",
      "properties": {
        "uml": {
          "region": "session-region"
        }
      }
    }
