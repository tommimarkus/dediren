<xmi:XMI xmlns:xmi="http://www.omg.org/spec/XMI/20131001" xmlns:uml="http://www.omg.org/spec/UML/20161101"><uml:Model xmi:id="id-dediren-uml-basic-model" name="Dediren UML Basic"><packagedElement xmi:type="uml:Interaction" xmi:id="id-interaction-lifecycle" name="Worker Lifecycle"><lifeline xmi:id="id-customer" name="Customer"/><lifeline xmi:id="id-service" name="Order Service"/><lifeline xmi:id="id-worker" name="Worker"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m1-send-event" name="placeOrder send" covered="id-customer" message="id-m1"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m1-receive-event" name="placeOrder receive" covered="id-service" message="id-m1"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m2-send-event" name="createWorker send" covered="id-service" message="id-m2"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m2-receive-event" name="createWorker receive" covered="id-worker" message="id-m2"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m3-send-event" name="destroyWorker send" covered="id-service" message="id-m3"/><fragment xmi:type="uml:DestructionOccurrenceSpecification" xmi:id="id-m3-receive-event" name="destroyWorker receive" covered="id-worker" message="id-m3"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m4-send-event" name="orderComplete send" covered="id-service" message="id-m4"/><fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="id-m4-receive-event" name="orderComplete receive" covered="id-customer" message="id-m4"/><fragment xmi:type="uml:BehaviorExecutionSpecification" xmi:id="id-exec-service" name="Order Service Activation" covered="id-service" start="id-m1-receive-event" finish="id-m4-send-event"/><message xmi:id="id-m1" name="placeOrder" messageSort="synchCall" sendEvent="id-m1-send-event" receiveEvent="id-m1-receive-event"/><message xmi:id="id-m2" name="createWorker" messageSort="createMessage" sendEvent="id-m2-send-event" receiveEvent="id-m2-receive-event"/><message xmi:id="id-m3" name="destroyWorker" messageSort="deleteMessage" sendEvent="id-m3-send-event" receiveEvent="id-m3-receive-event"/><message xmi:id="id-m4" name="orderComplete" messageSort="reply" sendEvent="id-m4-send-event" receiveEvent="id-m4-receive-event"/></packagedElement></uml:Model></xmi:XMI>
