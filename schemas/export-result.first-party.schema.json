{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dediren.dev/schemas/export-result.first-party.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["export_result_schema_version", "artifact_kind", "content"],
  "properties": {
    "export_result_schema_version": { "const": "export-result.schema.v2" },
    "artifact_kind": { "enum": ["archimate-oef+xml", "uml-xmi+xml", "drawio+xml"] },
    "content": { "type": "string" },
    "assurance": { "type": ["object", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact_kind": { "const": "uml-xmi+xml" } } },
      "then": {
        "required": ["assurance"],
        "properties": { "assurance": { "type": "object" } }
      }
    }
  ]
}
