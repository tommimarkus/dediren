{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dediren.dev/schemas/mcp-workspace.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mcp_workspace_schema_version",
    "workspace_id",
    "workspace_path",
    "expires_at"
  ],
  "properties": {
    "mcp_workspace_schema_version": { "const": "mcp-workspace.schema.v1" },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_path": {
      "type": "string",
      "pattern": "^\\.dediren/mcp/workspaces/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
