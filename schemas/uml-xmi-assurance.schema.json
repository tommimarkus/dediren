{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dediren.dev/schemas/uml-xmi-assurance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assurance_schema_version",
    "kind_taxonomy",
    "artifact_scope",
    "validation_evidence",
    "coverage"
  ],
  "properties": {
    "assurance_schema_version": { "const": "uml-xmi-assurance.schema.v1" },
    "kind_taxonomy": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/kindTaxonomyEntry" },
      "allOf": [
        { "contains": { "properties": { "kind": { "const": "uml-class" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-sequence" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-state-machine" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-use-case" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-component" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-deployment" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-activity" } }, "required": ["kind"] } },
        { "contains": { "properties": { "kind": { "const": "uml-data" } }, "required": ["kind"] } }
      ]
    },
    "artifact_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "selected_view_kinds"],
      "properties": {
        "scope": { "enum": ["view", "model-aggregate"] },
        "selected_view_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/viewKind" }
        }
      }
    },
    "validation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "xmi_schema_evidence",
        "uml_metamodel_evidence",
        "importer_evidence"
      ],
      "properties": {
        "level": {
          "enum": [
            "xmi-envelope-only",
            "uml-content-schema-validated",
            "importer-validated"
          ]
        },
        "xmi_schema_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["validated", "not-validated"] },
            "standard": { "type": "string", "minLength": 1 },
            "validator": { "type": "string", "minLength": 1 },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "uml_metamodel_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metamodel", "validator"],
            "properties": {
              "metamodel": { "type": "string", "minLength": 1 },
              "validator": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "minLength": 1 }
            }
          }
        },
        "importer_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["importer", "status"],
            "properties": {
              "importer": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "comment": "The weakest rung must not claim more than it has: at xmi-envelope-only no UML metamodel or importer evidence exists, so those arrays stay empty. Without this guard the rung carried no constraint at all, which is how an unconditional status=validated went unnoticed at exactly the level in use.",
          "if": { "properties": { "level": { "const": "xmi-envelope-only" } } },
          "then": {
            "properties": {
              "uml_metamodel_evidence": { "maxItems": 0 },
              "importer_evidence": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "level": { "const": "uml-content-schema-validated" } } },
          "then": { "properties": { "uml_metamodel_evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "level": { "const": "importer-validated" } } },
          "then": {
            "properties": {
              "uml_metamodel_evidence": { "minItems": 1 },
              "importer_evidence": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["represented", "omitted", "unrepresented_in_view"],
      "properties": {
        "represented": { "$ref": "#/$defs/coveragePartition" },
        "omitted": { "$ref": "#/$defs/coveragePartition" },
        "unrepresented_in_view": { "$ref": "#/$defs/coveragePartition" }
      }
    }
  },
  "$defs": {
    "viewKind": {
      "enum": [
        "uml-class",
        "uml-sequence",
        "uml-state-machine",
        "uml-use-case",
        "uml-component",
        "uml-deployment",
        "uml-activity",
        "uml-data"
      ]
    },
    "kindTaxonomyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "classification", "scope"],
      "properties": {
        "kind": { "$ref": "#/$defs/viewKind" },
        "classification": {
          "enum": ["standard-uml-diagram-kind", "dediren-local-classifier-view"]
        },
        "maps_to_uml_diagram_kind": { "const": "class" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["xmi_abstract_syntax", "aggregate_model", "uml_di"],
          "properties": {
            "xmi_abstract_syntax": { "const": "selected-view" },
            "aggregate_model": { "enum": ["included", "not-included"] },
            "uml_di": { "enum": ["provisional-aggregate", "none"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "uml-data" } } },
          "then": {
            "required": ["maps_to_uml_diagram_kind"],
            "properties": {
              "classification": { "const": "dediren-local-classifier-view" },
              "scope": {
                "properties": {
                  "aggregate_model": { "const": "included" },
                  "uml_di": { "const": "provisional-aggregate" }
                }
              }
            }
          },
          "else": {
            "not": { "required": ["maps_to_uml_diagram_kind"] },
            "properties": {
              "classification": { "const": "standard-uml-diagram-kind" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "uml-class" } } },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "aggregate_model": { "const": "included" },
                  "uml_di": { "const": "provisional-aggregate" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "uml-sequence",
                  "uml-state-machine",
                  "uml-use-case",
                  "uml-component",
                  "uml-deployment",
                  "uml-activity"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scope": {
                "properties": {
                  "aggregate_model": { "const": "not-included" },
                  "uml_di": { "const": "none" }
                }
              }
            }
          }
        }
      ]
    },
    "typeCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "coveragePartition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elements", "relationships", "element_total", "relationship_total"],
      "properties": {
        "elements": { "$ref": "#/$defs/typeCounts" },
        "relationships": { "$ref": "#/$defs/typeCounts" },
        "element_total": { "type": "integer", "minimum": 0 },
        "relationship_total": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
